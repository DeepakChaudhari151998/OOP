//Singleton pattern

class Singleton {
    private static instance
    constructor(){
        if (Singleton.instance){
            throw new Error ("Use Singleton.GetInstance() to create/get the object")
        }
        Singleton.instance = this

    }

    static GetInstance(){
        if(Singleton.instance){
            return Singleton.instance
        }
        Singleton.instance = this
        return Singleton.instance
    }
}

