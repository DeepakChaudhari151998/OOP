/** 
Proxy provides a substitute/representative object that controls access to another object.
Client
  |
  ↓
 Proxy
  |
  ↓
 Real Object

The client thinks it is communicating with the real object, but the Proxy gets a chance to control, validate, delay, cache, log, restrict, or otherwise manage the request.
*/



enum Users{
    ABCD = "abcd",
    PQR = "pqr"
}

enum Role{
    ADMIN ='admin',
    USER = 'user'
}

const userRoleMap = new Map<string, string>()
userRoleMap.set(Users.ABCD, Role.ADMIN)
userRoleMap.set(Users.PQR, Role.USER)

class TransactionDetails{
    getTransaction(){
        console.log("Transaction detail return")
    }

}


class ProxyTransaction{
    private transactionDetails:TransactionDetails
    constructor(transactionDetails:TransactionDetails){
        this.transactionDetails = transactionDetails
    }

    getTransaction(user:string) {
        if (userRoleMap.get(user) === Role.ADMIN) {
            this.transactionDetails.getTransaction();
        } else {
            console.log("Access denied");
        }
    }

}
const transactionDetails = new TransactionDetails()
const proxyTransaction = new ProxyTransaction(transactionDetails )
proxyTransaction.getTransaction(Users.ABCD)
proxyTransaction.getTransaction(Users.PQR)
