//Binary Search array should be sorted
//The time complexity of Binary Search is:
    //Best case: O(1) — the target is the middle element.
    //Average case: O(log n)
    //Worst case: O(log n)


const arr = [1,3,4,6,7,8,9]
let left = 0
let right = arr.length
const search = 7
function binarySearch(arr,left,right,search){
    while(left<=right){
        const mid = Math.floor((left+right)/2)
        if(arr[mid]==search){
            return mid
        }

        if(arr[mid]<search){
            left=mid+1
        } else{
            right= mid-1
        }
    }
    return -1
}
console.log(binarySearch(arr,left,right,search))
