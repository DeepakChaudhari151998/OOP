const string = '{[()]}'

const map = {
            ')':'(',
            '}':'{',
            ']':'['
            }

const stack =[]

function checkBracket(sting){
    if(sting.length%2!==0){
        return false
    }
    for(let i= 0;i<string.length;i++){
        if(!Object.keys(map).includes(string[i])){
            stack.push(string[i])
        } else {
            if(stack.pop() === map[string[i]]){
                continue
            } else {
                return false
            }
        }

    }
    return true
}

console.log(checkBracket(string))
